#!/bin/sh
# git credential helper: answers "get" with a fresh App token, so pushes are
# credited to icra-2027-psf-publisher[bot]. Ignores "store" and "erase", so the
# token is never saved anywhere.
[ "$1" = get ] || exit 0
for py in "$ICRA_PSF_PYTHON" python3 /usr/bin/python3 python; do
  [ -n "$py" ] && "$py" -c 'import jwt' 2>/dev/null && break
  py=
done
[ -n "$py" ] || { echo "git-credential-app: no python with PyJWT[crypto]" >&2; exit 1; }
tok=$("$py" "$(dirname "$0")/app_token.py") || exit 1
echo username=x-access-token
echo "password=$tok"
